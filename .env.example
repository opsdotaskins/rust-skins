# Runevault environment
# Neon PostgreSQL — this project's OWN dedicated database
DATABASE_URL="postgresql://user:password@ep-xxx.eu-west-2.aws.neon.tech/runevault?sslmode=require"

# Session signing secret (generate a long random string)
AUTH_SECRET="change-me-to-a-long-random-secret-string"

# Public site URL (used for canonical URLs, emails, OG)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# SMTP for transactional email (leave blank to log emails to console in dev)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Runevault <no-reply@runevault.example.com>"

# Public contact email (falls back to youremail@example.com if unset)
NEXT_PUBLIC_CONTACT_EMAIL=""

# Sterling Pay / Corefy Payment Gateway (Visa / Mastercard HPP)
COREFY_API_URL="https://api.sterling-pay.com"
COREFY_ACCOUNT_ID=""
COREFY_API_KEY=""
COREFY_WEBHOOK_SECRET=""
COREFY_SERVICE="payment_card_eur_hpp"
COREFY_CURRENCY="EUR"
COREFY_TEST_MODE="false"
